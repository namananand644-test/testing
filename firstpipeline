
pipeline {
    agent any

    stages {
        stage('Start Pipeline') {
            steps {
                echo '🚀 Automatic CI Pipeline Started!'
                echo "Build Number: ${BUILD_NUMBER}"
                echo "Triggered by: ${BUILD_TAG}"
            }
        }

        stage('Check Environment') {
            steps {
                sh 'echo "Checking Linux environment..."'
                sh 'hostname'
                sh 'pwd'
                sh 'date'
            }
        }

        stage('Run Application Test') {
            steps {
                echo 'Running application tests...'
                sh 'echo "Test 1: Application initialized successfully"'
                sh 'echo "Test 2: Environment check passed"'
                sh 'echo "Test 3: CI pipeline passed"'
            }
        }

        stage('Pipeline Completed') {
            steps {
                echo '🎉 All stages completed successfully!'
            }
        }
    }

    post {
        success {
            echo '✅ CI BUILD SUCCESSFUL!'
        }

        failure {
            echo '❌ CI BUILD FAILED!'
        }
    }
}
