
pipeline {
    agent {
        docker {
            image 'python:3.12-slim'
        }
    }

    stages {
        stage('Check Container') {
            steps {
                sh 'echo "Hello from Jenkins Docker Agent!"'
                sh 'id'
                sh 'hostname'
                sh 'cat /etc/os-release'
            }
        }

        stage('Check Python') {
            steps {
                sh 'python --version'
                sh 'python -c "print(\"Python is running inside Docker!\")"'
            }
        }

        stage('Keep Container Alive') {
            steps {
                sh 'echo "Container is running!"'
                sh 'sleep 30'
            }
        }
    }
}
