
pipeline {
    agent none

    stages {

        stage('Python Agent') {
            agent {
                docker {
                    image 'python:3.12-slim'
                }
            }

            steps {
                echo 'Running inside Python Docker Agent'

                sh 'echo "Checking Python environment"'
                sh 'python --version'
                sh 'python -c "print(10 + 20)"'
                sh 'sleep 20'
            }
        }

        stage('Node Agent') {
            agent {
                docker {
                    image 'node:22-alpine'
                }
            }

            steps {
                echo 'Running inside Node.js Docker Agent'

                sh 'echo "Checking Node.js environment"'
                sh 'node --version'
                sh 'npm --version'
                sh 'node -e "console.log(10 + 20)"'
                sh 'sleep 20'
            }
        }

        stage('Pipeline Completed') {
            agent any

            steps {
                echo 'Both Docker agents completed successfully!'
                sh 'hostname'
                sh 'whoami'
            }
        }
    }
}
